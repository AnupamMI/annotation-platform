# Copy to .env and change the passwords. Never commit .env.

POSTGRES_USER=annot
POSTGRES_PASSWORD=annot_dev_password
POSTGRES_DB=annot

MINIO_ROOT_USER=annot
MINIO_ROOT_PASSWORD=annot_dev_password

# Backend
# Where image files go: "s3" = MinIO from docker compose, "local" = a folder (LOCAL_STORAGE_DIR)
STORAGE_BACKEND=s3
DATABASE_URL=postgresql+asyncpg://annot:annot_dev_password@localhost:5432/annot
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=annot
S3_SECRET_KEY=annot_dev_password
S3_BUCKET=annot-data

# Demo logins: python -m app.seed prints a random password once. Set this to choose it yourself.
# DEMO_PASSWORD=
# Set to true when the site is served over HTTPS, so the sign-in cookie is only sent over HTTPS.
COOKIE_SECURE=false

# Ask and agents. Provider is pluggable: "anthropic", "openai" (or any OpenAI-compatible server), "ollama", or "none".
# With "none", Ask still answers common questions with fixed queries, searches guidelines, and runs agents.
# Example for Claude: LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5-5  LLM_API_KEY=sk-ant-...
# Only question text, the read-only query and its result rows (pseudonymous IDs, never patient names) are sent to the model.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434     # Ollama on another machine, or an OpenAI-compatible server
# ASK_TIMEOUT_MS=5000                     # a question's query is stopped after this long
# ASK_ROW_LIMIT=200
